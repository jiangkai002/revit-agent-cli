<ui:FluentWindow x:Class="RevitAgent.Gui.Views.SkillViewWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 xmlns:mdxaml="clr-namespace:MdXaml;assembly=MdXaml"
                 Title="技能详情"
                 Icon="pack://application:,,,/RevitAgent.Gui;component/Assets/RevitAgent.ico"
                 Width="780"
                 Height="640"
                 MinWidth="520"
                 MinHeight="400"
                 FontFamily="{StaticResource AppFontFamily}"
                 ExtendsContentIntoTitleBar="True"
                 WindowStartupLocation="CenterOwner"
                 Background="{DynamicResource ApplicationBackgroundBrush}">
    <Grid ClipToBounds="True">
        <Grid.RowDefinitions>
            <RowDefinition Height="48" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <ui:TitleBar Grid.Row="0" Title="技能详情"
                     ShowMinimize="True" ShowMaximize="True" ShowClose="True" />
        <Grid Grid.Row="1" Margin="24,14,24,22" MinHeight="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="14" />
                <RowDefinition Height="*" />
                <RowDefinition Height="14" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <StackPanel>
                <TextBlock Text="技能详情" Style="{StaticResource PageTitleStyle}" FontSize="22" />
                <TextBlock Text="查看技能说明、使用约束与代码模板。"
                           Style="{StaticResource PageSubtitleStyle}" Margin="0,3,0,0" />
            </StackPanel>
            <Border Grid.Row="2" Style="{StaticResource SurfaceCardStyle}" Padding="0"
                    MinHeight="0" ClipToBounds="True">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="20,16" MinHeight="0">
                    <mdxaml:MarkdownScrollViewer x:Name="SkillBodyViewer"
                                                 MarkdownStyle="{StaticResource FluentMarkdownStyle}"
                                                 Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                                 Background="Transparent" />
                </ScrollViewer>
            </Border>
            <ui:Button Grid.Row="4" Content="关闭" MinWidth="88"
                       HorizontalAlignment="Right" Click="Close_OnClick" />
        </Grid>
    </Grid>
</ui:FluentWindow>
