<local:NavigationPage x:Class="RevitAgent.Gui.Views.ChatPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:mdxaml="clr-namespace:MdXaml;assembly=MdXaml"
      xmlns:models="clr-namespace:RevitAgent.Gui.Models"
      xmlns:local="clr-namespace:RevitAgent.Gui.Views"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      mc:Ignorable="d" d:DesignHeight="720" d:DesignWidth="960"
      Background="Transparent" TextOptions.TextRenderingMode="ClearType"
      PreviewMouseWheel="ChatPage_OnPreviewMouseWheel">
    <Grid Margin="28,18,28,24" MinHeight="0" ClipToBounds="True">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="16" />
            <RowDefinition Height="*" />
            <RowDefinition Height="16" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="智能会话" Style="{StaticResource PageTitleStyle}" />
                <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                    <Border Background="{DynamicResource ControlFillColorSecondaryBrush}"
                            BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                            BorderThickness="1" CornerRadius="12" Padding="9,3">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="6" Height="6" Margin="0,0,7,0" VerticalAlignment="Center"
                                     Fill="{DynamicResource AccentFillColorDefaultBrush}" />
                            <TextBlock Text="{Binding StageDisplayText}"
                                       FontSize="12" VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>
                    <TextBlock Text="{Binding ModelSummary}" Style="{StaticResource CaptionStyle}"
                               VerticalAlignment="Center" Margin="12,0,0,0" />
                </StackPanel>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <ui:Button Content="选择模型" Command="{Binding PickModelsCommand}"
                           MinWidth="96" Margin="0,0,8,0" />
                <ui:Button Content="新会话" Command="{Binding NewConversationCommand}" MinWidth="88" />
            </StackPanel>
        </Grid>

        <Border Grid.Row="2" Style="{StaticResource SurfaceCardStyle}" Padding="0"
                MinHeight="0" ClipToBounds="True">
            <ScrollViewer x:Name="Transcript" Padding="22,16"
                          MinHeight="0"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled"
                          CanContentScroll="False">
                <ItemsControl ItemsSource="{Binding Items}" HorizontalAlignment="Stretch">
                    <ItemsControl.Resources>
                        <DataTemplate DataType="{x:Type models:UserMessage}">
                            <Grid Margin="80,7,0,7">
                                <Border HorizontalAlignment="Right"
                                        Background="{DynamicResource AccentFillColorDefaultBrush}"
                                        CornerRadius="14,14,4,14" Padding="15,10" MaxWidth="650">
                                    <TextBlock Text="{Binding Text}" TextWrapping="Wrap"
                                               Foreground="White" LineHeight="21" />
                                </Border>
                            </Grid>
                        </DataTemplate>
                        <DataTemplate DataType="{x:Type models:AssistantMessage}">
                            <Border HorizontalAlignment="Left" MaxWidth="880"
                                    Background="{DynamicResource ControlFillColorSecondaryBrush}"
                                    BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                                    BorderThickness="1" CornerRadius="4,14,14,14"
                                    Padding="15,10" Margin="0,7,80,7">
                                <mdxaml:MarkdownScrollViewer Markdown="{Binding Markdown}"
                                      MarkdownStyle="{StaticResource FluentMarkdownStyle}"
                                      Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                      Background="Transparent" VerticalScrollBarVisibility="Disabled" />
                            </Border>
                        </DataTemplate>
                        <DataTemplate DataType="{x:Type models:ReasoningSection}">
                            <Expander Margin="0,5,80,5" Padding="2">
                                <Expander.Header>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="思考过程" FontWeight="SemiBold" FontSize="12" />
                                        <TextBlock Text="{Binding Preview, StringFormat=' · {0}'}"
                                                   TextTrimming="CharacterEllipsis" Opacity="0.65"
                                                   FontSize="12" MaxWidth="520" />
                                    </StackPanel>
                                </Expander.Header>
                                <Border Style="{StaticResource SubtleCardStyle}" Margin="0,7,0,0">
                                    <TextBlock Text="{Binding Text}" TextWrapping="Wrap"
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                               FontSize="12" LineHeight="19" />
                                </Border>
                            </Expander>
                        </DataTemplate>
                        <DataTemplate DataType="{x:Type models:ToolCallItem}">
                            <Expander Margin="0,5,80,5">
                                <Expander.Header>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="执行工具" FontWeight="SemiBold" FontSize="12" />
                                        <TextBlock Text="{Binding Name, StringFormat=' · {0}'}" FontSize="12" />
                                        <TextBlock Text="{Binding Length, StringFormat=' · {0} 字符'}"
                                                   Style="{StaticResource CaptionStyle}" Margin="6,0,0,0" />
                                    </StackPanel>
                                </Expander.Header>
                                <TextBox Text="{Binding ArgumentsText, Mode=OneWay}" IsReadOnly="True"
                                         FontFamily="{StaticResource AppMonospaceFontFamily}" FontSize="12"
                                         TextWrapping="NoWrap" MaxHeight="360"
                                         VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                                         Background="{DynamicResource ControlFillColorSecondaryBrush}"
                                         Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                         BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                                         Margin="0,7,0,0" Padding="10" />
                            </Expander>
                        </DataTemplate>
                        <DataTemplate DataType="{x:Type models:ToolResultItem}">
                            <Expander Margin="0,5,80,5">
                                <Expander.Header>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="工具结果" FontWeight="SemiBold" FontSize="12" />
                                        <TextBlock Text="{Binding Length, StringFormat=' · {0} 字符'}"
                                                   Style="{StaticResource CaptionStyle}" Margin="6,0,0,0" />
                                    </StackPanel>
                                </Expander.Header>
                                <TextBox Text="{Binding ResultText, Mode=OneWay}" IsReadOnly="True"
                                         FontFamily="{StaticResource AppMonospaceFontFamily}" FontSize="12"
                                         TextWrapping="NoWrap" MaxHeight="360"
                                         VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                                         Background="{DynamicResource ControlFillColorSecondaryBrush}"
                                         Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                         BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                                         Margin="0,7,0,0" Padding="10" />
                            </Expander>
                        </DataTemplate>
                        <DataTemplate DataType="{x:Type models:InfoItem}">
                            <Border Background="{DynamicResource SystemFillColorNeutralBackgroundBrush}"
                                    CornerRadius="6" Padding="10,6" Margin="0,5,80,5" HorizontalAlignment="Left">
                                <TextBlock Text="{Binding Text}" Style="{StaticResource CaptionStyle}" />
                            </Border>
                        </DataTemplate>
                        <DataTemplate DataType="{x:Type models:ErrorMessage}">
                            <Border Background="{DynamicResource SystemFillColorCriticalBackgroundBrush}"
                                    CornerRadius="6" Padding="10,7" Margin="0,5,80,5">
                                <TextBlock Text="{Binding Text, StringFormat='⚠  {0}'}" TextWrapping="Wrap"
                                           Foreground="{DynamicResource SystemFillColorCriticalBrush}" FontSize="12" />
                            </Border>
                        </DataTemplate>
                    </ItemsControl.Resources>
                </ItemsControl>
            </ScrollViewer>
        </Border>

        <Border Grid.Row="4" Style="{StaticResource SurfaceCardStyle}" Padding="14">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBox x:Name="InputBox" Text="{Binding InputText, UpdateSourceTrigger=PropertyChanged}"
                         AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                         MaxHeight="150" MinHeight="66" VerticalContentAlignment="Top"
                         Background="Transparent" BorderThickness="0" Padding="2"
                         Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                         CaretBrush="{DynamicResource TextFillColorPrimaryBrush}"
                         KeyDown="InputBox_OnKeyDown" />
                <Grid Grid.Row="1" Margin="2,10,0,0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="Revit" Style="{StaticResource CaptionStyle}" VerticalAlignment="Center" />
                        <ComboBox ItemsSource="{Binding RevitVersions}" SelectedItem="{Binding RevitVersion}"
                                  MinWidth="86" Margin="8,0,0,0" />
                        <TextBlock Text="Ctrl + Enter 发送" Style="{StaticResource CaptionStyle}"
                                   VerticalAlignment="Center" Margin="14,0,0,0" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <ui:Button Content="停止" Command="{Binding StopCommand}" MinWidth="72" Margin="0,0,8,0" />
                        <ui:Button Content="发送" Appearance="Primary"
                                   Command="{Binding SendCommand}" MinWidth="88" />
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</local:NavigationPage>
