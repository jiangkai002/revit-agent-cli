<ui:FluentWindow x:Class="RevitAgent.Gui.MainWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 xmlns:views="clr-namespace:RevitAgent.Gui.Views"
                 Title="RevitAgent"
                 Icon="pack://application:,,,/RevitAgent.Gui;component/Assets/RevitAgent.ico"
                 Width="1240"
                 Height="820"
                 MinWidth="860"
                 MinHeight="560"
                 FontFamily="{StaticResource AppFontFamily}"
                 ExtendsContentIntoTitleBar="True"
                 WindowStartupLocation="CenterScreen"
                 Background="{DynamicResource ApplicationBackgroundBrush}">
    <Grid ClipToBounds="True">
        <Grid.RowDefinitions>
            <RowDefinition Height="48" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- FluentWindow removes the system chrome when content extends into the title bar.
             TitleBar restores caption buttons, drag, double-click maximize and resize hit tests. -->
        <ui:TitleBar Grid.Row="0"
                     Title="RevitAgent"
                     ShowMinimize="True"
                     ShowMaximize="True"
                     ShowClose="True" />

        <!-- Binding the navigation view to a finite host height is intentional. NavigationView
             otherwise measures navigated pages with an unbounded height, which lets a long
             transcript grow the whole page instead of activating its inner ScrollViewer. -->
        <Border x:Name="NavigationHost" Grid.Row="1" ClipToBounds="True">
            <ui:NavigationView x:Name="RootNavigation"
                               Height="{Binding ActualHeight, ElementName=NavigationHost}"
                               VerticalAlignment="Top"
                               PaneDisplayMode="Left"
                               IsBackButtonVisible="Collapsed"
                               IsPaneToggleVisible="True"
                               OpenPaneLength="224"
                               CompactPaneLength="56"
                               ScrollViewer.VerticalScrollBarVisibility="Disabled">
                <ui:NavigationView.MenuItems>
                    <ui:NavigationViewItem Content="会话" TargetPageType="{x:Type views:ChatPage}">
                        <ui:NavigationViewItem.Icon>
                            <ui:SymbolIcon Symbol="ChatEmpty24" />
                        </ui:NavigationViewItem.Icon>
                    </ui:NavigationViewItem>
                    <ui:NavigationViewItem Content="技能" TargetPageType="{x:Type views:SkillsPage}">
                        <ui:NavigationViewItem.Icon>
                            <ui:SymbolIcon Symbol="Toolbox24" />
                        </ui:NavigationViewItem.Icon>
                    </ui:NavigationViewItem>
                </ui:NavigationView.MenuItems>
                <ui:NavigationView.FooterMenuItems>
                    <ui:NavigationViewItem Content="设置" TargetPageType="{x:Type views:SettingsPage}">
                        <ui:NavigationViewItem.Icon>
                            <ui:SymbolIcon Symbol="Settings24" />
                        </ui:NavigationViewItem.Icon>
                    </ui:NavigationViewItem>
                </ui:NavigationView.FooterMenuItems>
            </ui:NavigationView>
        </Border>
    </Grid>
</ui:FluentWindow>
